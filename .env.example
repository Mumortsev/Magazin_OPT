# Telegram Bot
BOT_TOKEN=your_bot_token_here

# Admin Telegram IDs (comma-separated)
ADMIN_IDS=

# Database (Use /app/data for persistence on Amvera)
DATABASE_URL=sqlite:////app/data/shop.db

# Mini App URL (will be set after deployment)
WEBAPP_URL=https://yourdomain.com

# API Settings
API_HOST=0.0.0.0
API_PORT=8000

# Debug mode
DEBUG=true

# WhatsApp Business API
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id_here
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token_here

